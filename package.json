{
  "name": "slopcast-monorepo",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/Baysul/slopcast",
  "author": "Basil <parsley@duck.com>",
  "scripts": {
    "check": "pnpm --filter @slopcast/shared-types build && vp check && pnpm --recursive check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write && pnpm --filter @slopcast/native-rust rust:fmt",
    "rust:fmt": "pnpm --filter @slopcast/native-rust rust:fmt",
    "rust:check": "pnpm --filter @slopcast/native-rust rust:check",
    "dev": "pnpm --parallel --recursive dev",
    "dev:desktop": "pnpm desktop:prepare-gstreamer && pnpm --filter desktop dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "desktop:install-entry": "bash scripts/install-dev-desktop-entry.sh",
    "desktop:prepare-gstreamer": "bash scripts/prepare-gstreamer-runtime.sh",
    "test:e2e": "pnpm --filter server test:e2e",
    "build": "pnpm check && pnpm --recursive build",
    "build:desktop": "pnpm check && pnpm desktop:prepare-gstreamer && cargo build --release --locked -p slopcast",
    "package:desktop": "pnpm check && bash scripts/package-desktop.sh",
    "dist:desktop": "pnpm check && bash scripts/package-desktop.sh",
    "dist:desktop:linux": "pnpm check && bash scripts/package-desktop.sh --bundles deb,appimage,tar",
    "dist:desktop:linux:appimage": "pnpm check && bash scripts/package-desktop.sh --bundles appimage",
    "dist:desktop:linux:deb": "pnpm check && bash scripts/package-desktop.sh --bundles deb",
    "dist:desktop:linux:tar": "pnpm check && bash scripts/package-desktop.sh --bundles tar",
    "dist:desktop:win": "pnpm check && bash scripts/package-desktop.sh --bundles nsis",
    "test": "vp test",
    "test:unit": "vp test"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
