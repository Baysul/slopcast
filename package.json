{
  "name": "slopcast-monorepo",
  "desktopName": "slopcast-app",
  "author": "Basil <parsley@duck.com>",
  "homepage": "https://github.com/npm/example#readme",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "biome ci && pnpm --filter @slopcast/native-rust rust:check",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write && pnpm --filter @slopcast/native-rust rust:fmt",
    "rust:fmt": "pnpm --filter @slopcast/native-rust rust:fmt",
    "rust:check": "pnpm --filter @slopcast/native-rust rust:check",
    "dev": "pnpm --parallel --recursive dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "test:e2e": "pnpm --filter server test:e2e",
    "build": "pnpm check && pnpm --recursive build",
    "build:desktop": "pnpm check && pnpm --filter desktop build",
    "package:desktop": "pnpm check && pnpm --filter desktop package",
    "dist:desktop": "pnpm check && pnpm --filter desktop dist",
    "dist:desktop:linux": "pnpm check && pnpm --filter desktop dist:linux",
    "dist:desktop:mac": "pnpm check && pnpm --filter desktop dist:mac",
    "dist:desktop:win": "pnpm check && pnpm --filter desktop dist:win"
  },
  "dependencies": {
    "opencode-goal-plugin": "^0.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "playwright": "^1.55.0"
  }
}
