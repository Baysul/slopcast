{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "slopcast",
  "version": "0.1.0",
  "identifier": "slopcast",
  "build": {
    "beforeDevCommand": "pnpm --filter @slopcast/shared-types build && pnpm --filter desktop dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @slopcast/shared-types build && pnpm --filter desktop build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Slopcast Desktop Presenter",
        "width": 1100,
        "height": 900,
        "decorations": false,
        "backgroundColor": "#090d16",
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 http://localhost:3001 http://127.0.0.1:3001 wss: https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "linux": {
      "deb": {
        "desktopTemplate": "templates/main.desktop",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libpipewire-0.3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
