  "homepage": "https://github.com/Baysul/slopcast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "tsc -p tsconfig.renderer.json --noEmit && cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "pnpm --filter @slopcast/shared-types build && vite build",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "wdio": "wdio run ./wdio.conf.ts",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@slopcast/shared-types": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.0",
    "vite": "^6.0.0"
  }
}
