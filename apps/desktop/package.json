{
  "name": "desktop",
  "author": "Basil <parsley@duck.com>",
  "desktopName": "screen-share-app",
  "homepage": "https://github.com/npm/example#readme",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "predev": "pnpm --filter @screen-share/native-rust build:debug",
    "prebuild": "pnpm --filter @screen-share/native-rust build",
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json && cp src/main/preload.js dist/main/preload.js && vite build",
    "build:main": "tsc -p tsconfig.json && cp src/main/preload.js dist/main/preload.js",
    "build:renderer": "vite build",
    "start": "electron .",
    "package": "pnpm build && electron-builder build --dir",
    "dist": "pnpm build && electron-builder build",
    "dist:linux": "pnpm build && electron-builder build --linux",
    "dist:mac": "pnpm build && electron-builder build --mac",
    "dist:win": "pnpm build && electron-builder build --win"
  },
  "dependencies": {
    "@screen-share/native-rust": "workspace:*",
    "@screen-share/shared-types": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "ws": "^8.18.0"
  }
}
